# Copy this file to .env and fill in real values. Never commit .env.
# Every value here has a safe development default in grc_agent/config/settings.py
# except where noted; you only need to set what the deliverable you're running requires.

# --- Core / runtime ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data

# --- Neo4j (knowledge graph) -------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DATABASE=neo4j

# --- ChromaDB (vector store) --------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (Anthropic Claude) — required from Deliverable 5 onward -------------
ANTHROPIC_API_KEY=
LLM_MODEL_MAPPING=claude-sonnet-4-5
LLM_MODEL_SYNTHESIS=claude-sonnet-4-5

# --- Reference-data source credentials ----------------------------------------
# Optional: raises the NVD REST API rate limit from 5 to 50 requests/30s.
NVD_API_KEY=

# --- Vendor normalizer credentials (read-only tokens only, per NFR-07) --------
# Tenable.io — required from Deliverable 4 onward.
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# --- Scheduled refresh cadences (cron expressions) -----------------------------
REFRESH_CRON_FRAMEWORKS=0 0 1 */3 *
REFRESH_CRON_DAILY=0 6 * * *
